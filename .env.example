# NOVA X Environment Configuration Example

# System & App Environment
APP_ENV=development
APP_SECRET=nova-x-development-super-secret-key-change-in-production
JWT_SECRET=nova-x-jwt-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Network & URLs
PORT=8000
FRONTEND_PORT=5173
HOST=127.0.0.1
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Databases
MONGODB_URL=mongodb://localhost:27017/nova_x
REDIS_URL=redis://localhost:6379/0
USE_IN_MEMORY_FALLBACK=true

# Vector Database
VECTOR_DB_PROVIDER=in_memory
VECTOR_DB_URL=http://localhost:6333
VECTOR_COLLECTION_PREFIX=nova_

# Model Providers
DEFAULT_AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Search Provider
SEARCH_PROVIDER=mock
SEARCH_API_KEY=

# File Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./data/storage

# Desktop Companion Security
DESKTOP_COMPANION_PORT=9000
DESKTOP_SECRET_TOKEN=nova-desktop-local-token-change-in-production
ALLOW_DESKTOP_CONTROL=false
DEFAULT_APPROVED_DIRS=

# Code Runner Sandbox
CODE_RUNNER_TIMEOUT_SECONDS=5.0
CODE_RUNNER_MAX_RAM_MB=256
